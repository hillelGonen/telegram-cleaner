# Optional: `tgo` asks for these on first run and saves them to ~/.tgo/.env.
# Get them at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Optional: where db, session and backups live
# (default: ./data if it already exists here, else ~/.tgo/data)
# TGO_DATA_DIR=./data

# Set to false if your terminal already renders Hebrew/Arabic correctly
# TGO_BIDI=true

# Not used yet (maybe later: AI folder suggestions)
# ANTHROPIC_API_KEY=
